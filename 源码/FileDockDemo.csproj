<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>FileDockDemo.App</StartupObject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FileDock</AssemblyName>
    <Title>文件坞 File Dock</Title>
    <Product>文件坞 File Dock</Product>
    <Description>常驻 Windows 桌面的文件启动器与电脑状态面板</Description>
    <RootNamespace>FileDockDemo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.8.0-rc.8</Version>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <ApplicationIcon>Assets\FileDock-dark.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <!-- WPF owns DPI configuration; WinForms supplies the tray and edge tab. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Compile Remove="TemperatureService\**\*.cs" /><None Remove="TemperatureService\bin\**;TemperatureService\obj\**" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\*.ico;Assets\*.png" /></ItemGroup>
</Project>

