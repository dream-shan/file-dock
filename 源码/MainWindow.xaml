<Window x:Class="FileDockDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileDockDemo"
        Title="文件坞" Icon="Assets/FileDock-dark.ico" Width="462" Height="650" MinWidth="412" MinHeight="480"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource Surface}" PreviewMouseLeftButtonDown="MovePanelFromSurface"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True" Loaded="Window_Loaded" Deactivated="Window_Deactivated"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <local:HalfWidthConverter x:Key="HalfWidth" />
        <Style x:Key="QuietFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="2" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Accent}" IsHitTestVisible="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="QuietButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource QuietFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Pressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBoxItem" x:Key="PlainItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChosen}" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="PageRoot"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Grid.Column="1" x:Name="PanelSurface" Margin="0" Tag="PanelDrag" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="20">
        <Grid x:Name="ContentGrid" Margin="19,17,19,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" Tag="PanelDrag" Margin="0,0,0,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="AppLogo" Source="Assets/FileDock-dark.png" Width="31" Height="31" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="文件坞" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Badge}" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{x:Static local:App.VersionLabel}">
                        <TextBlock x:Name="ReleaseBadge" Text="RC" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource BadgeText}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="KeepOpenButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="保持展开" AutomationProperties.Name="保持展开" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="设置" AutomationProperties.Name="设置" Margin="2,0" />
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE76C;"
                            ToolTip="收起到屏幕边缘" AutomationProperties.Name="收起" />
                </StackPanel>
            </Grid>

            <Border x:Name="FileSearchSurface" Grid.Row="1" Background="{DynamicResource Input}" CornerRadius="11" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Padding="12,0" Height="42" Margin="0,0,0,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                                 FontSize="12" Foreground="{DynamicResource Ink}" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="搜索文件名或路径" />
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索常用文件或路径" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4"
                            Padding="4,1" VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="Ctrl F" FontFamily="Segoe UI" FontSize="9" Foreground="{DynamicResource Muted}" />
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="PinsSection" Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" Tag="PanelDrag" /><TextBlock Tag="PanelDrag" Text="我的常用" Style="{StaticResource SectionHeading}" />
                <Button x:Name="AddButton" Content="＋ 添加" Style="{StaticResource QuietButton}" Foreground="{DynamicResource Accent}"
                        HorizontalAlignment="Right" ToolTip="添加常用文件或文件夹" />
                <Grid Grid.Row="1">
                    <TextBlock x:Name="PinsEmptyText" Text="点击“＋ 添加”，选择常用文件或文件夹" Foreground="{DynamicResource Muted}"
                               FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="10,17" Visibility="Visible" />
                    <ListBox x:Name="PinsList" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                             ItemContainerStyle="{StaticResource PlainItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:VirtualizingPinPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalAlignment="Stretch" Height="70" Margin="0,3,5,3" Tag="{Binding}" Click="Item_Open"
                                         Background="{DynamicResource Card}" Style="{StaticResource QuietButton}"
                                        Padding="11,9" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="31" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource IconSurface}" Width="27" Height="32" CornerRadius="7" VerticalAlignment="Center">
                                            <local:EntryThumbnail />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Ink}" FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <Grid x:Name="PerformanceSection" Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent" Tag="PanelDrag" /><TextBlock Tag="PanelDrag" Text="电脑状态" Style="{StaticResource SectionHeading}" />
                <TextBlock x:Name="PerformanceHint" Text="实时更新 · 1 秒" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <ScrollViewer x:Name="PerformanceScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid MinHeight="190">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <local:PerformanceCard x:Name="CpuCard" Label="CPU" Trend="True" Accent="#4A6CF7" Margin="0,0,4,4" MinHeight="91" />
                        <local:PerformanceCard x:Name="GpuCard" Label="GPU" Trend="True" Accent="#8B68D8" Grid.Column="1" Margin="4,0,0,4" MinHeight="91" />
                        <local:PerformanceCard x:Name="MemoryCard" Label="内存" Ring="True" Accent="#239C88" Grid.Row="1" Margin="0,4,4,0" MinHeight="91" />
                        <local:PerformanceCard x:Name="VramCard" Label="显存" Ring="True" Accent="#C38A3A" Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" MinHeight="91" />
                    </Grid>
                </ScrollViewer>
                <Border x:Name="NetworkBar" Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="8" Padding="10,4" Margin="0,7,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="实时网速" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="NetworkDownload" Grid.Column="1" Text="↓ —" FontSize="10" Foreground="{DynamicResource MemoryAccent}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NetworkUpload" Grid.Column="2" Text="↑ —" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="BrowserPanel" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="FolderBackButton" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="返回（Alt + ←）" AutomationProperties.Name="返回" />
                        <Button x:Name="FolderUpButton" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="上一级（Alt + ↑）" AutomationProperties.Name="上一级" Margin="3,0" />
                    </StackPanel>
                    <Button x:Name="FolderHomeButton" Grid.Column="1" Style="{StaticResource QuietButton}" Content="我的常用" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left" ToolTip="回到我的常用" />
                    <Button x:Name="FolderRefreshButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新当前文件夹" AutomationProperties.Name="刷新当前文件夹" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource Card}" CornerRadius="11" Padding="12,11" Margin="0,0,0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Data="M 1,6 L 1,3 Q 1,1 3,1 L 11,1 L 14,5 L 26,5 Q 28,5 28,7 L 28,21 Q 28,23 26,23 L 3,23 Q 1,23 1,21 Z M 1,8 L 28,8" Stroke="{DynamicResource FolderStroke}" StrokeThickness="1.5" Fill="{DynamicResource FolderFill}" Width="27" Height="25" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="FolderTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" />
                            </ScrollViewer>
                            <TextBlock x:Name="FolderPathText" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FolderCountText" Text="文件夹内容" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="FolderFilterComboBox" Grid.Column="1" Width="73" Height="24" SelectedIndex="0" FontSize="11" Foreground="{DynamicResource Muted}" AutomationProperties.Name="当前文件夹类型筛选">
                        <ComboBoxItem Content="全部" /><ComboBoxItem Content="文档" /><ComboBoxItem Content="表格" /><ComboBoxItem Content="图片" /><ComboBoxItem Content="文件夹" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="3">
                    <ListBox x:Name="FolderList" BorderThickness="0" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource PlainItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="Item_Open" Style="{StaticResource QuietButton}" Padding="7,9" HorizontalContentAlignment="Stretch" >
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Width="29" Height="34" Background="{DynamicResource Card}" CornerRadius="8" HorizontalAlignment="Left">
                                            <local:EntryThumbnail />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,9,0">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Ink}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Muted}" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="FolderEmptyText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Grid>

            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="{DynamicResource Muted}" FontSize="9.5" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="1,0,0,7" />
                <Grid Grid.Row="1">
                    <TextBlock x:Name="HotkeyHint" Text="Ctrl + Alt + Space  唤出" FontSize="9.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="InteractionHint" Text="文件夹内浏览 · 文件单击打开" FontSize="9.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
        <StackPanel x:Name="PageRail" Grid.Column="0" VerticalAlignment="Top" Margin="0,90,0,0">
            <StackPanel.Resources>
                <Style x:Key="PageTabStyle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="44" />
                    <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{DynamicResource Card}" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter Property="Cursor" Value="Hand" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="15" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource QuietFocusVisual}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Width" Value="32" /><Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </StackPanel.Resources>
            <ToggleButton x:Name="FilesPageTab" Style="{StaticResource PageTabStyle}" Content="&#xE8B7;" Tag="Files" Click="PageTab_Click" ToolTip="文件：常用、浏览和搜索" AutomationProperties.Name="文件页" />
            <ToggleButton x:Name="PerformancePageTab" Style="{StaticResource PageTabStyle}" Content="&#xE9D9;" Tag="Performance" Click="PageTab_Click" ToolTip="性能：电脑状态" AutomationProperties.Name="性能页" />
        </StackPanel>
        <Thumb x:Name="PanelResizeGrip" Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Cursor="SizeNWSE" DragDelta="PanelResizeGrip_DragDelta" ToolTip="调整大小">
            <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Path Data="M 4,12 L 12,4 M 8,12 L 12,8" Stroke="{DynamicResource Muted}" StrokeThickness="1" /></Grid></ControlTemplate></Thumb.Template>
        </Thumb>
    </Grid>
</Window>


